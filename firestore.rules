rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isPresenceOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasValidPresenceFields(data) {
      return data.keys().hasAll([
        'displayName',
        'latitude',
        'longitude',
        'isVisible',
        'lastSeen'
      ]) && data.keys().hasOnly([
        'displayName',
        'latitude',
        'longitude',
        'isVisible',
        'lastSeen'
      ]);
    }

    function hasValidPresenceValues(data) {
      return data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 100
        && data.latitude is number
        && data.latitude >= -90
        && data.latitude <= 90
        && data.longitude is number
        && data.longitude >= -180
        && data.longitude <= 180
        && data.isVisible == true
        && data.lastSeen is timestamp
        && data.lastSeen == request.time;
    }

    // --- matches helpers ---

    function hasValidMatchResultFields(data) {
      return data.keys().hasAll([
        'matchId',
        'participantIds',
        'rounds',
        'results',
        'completedAt',
        'uploadedBy',
        'createdAt'
      ]) && data.keys().hasOnly([
        'matchId',
        'participantIds',
        'rounds',
        'results',
        'completedAt',
        'uploadedBy',
        'createdAt'
      ]);
    }

    // On create, `resource` is null — compare matchId to the path wildcard.
    function hasValidMatchResultValues(data, matchId) {
      return data.matchId is string
        && data.matchId == matchId
        && data.participantIds is list
        && data.participantIds.size() == 2
        && data.participantIds[0] is string
        && data.participantIds[1] is string
        && data.participantIds[0].size() > 0
        && data.participantIds[1].size() > 0
        && data.participantIds[0] != data.participantIds[1]
        && data.rounds is list
        && data.rounds.size() >= 3
        && data.rounds.size() <= 4
        && data.results is map
        && data.results.keys().hasOnly(data.participantIds)
        && data.results.keys().hasAll(data.participantIds)
        && (
          (data.results[data.participantIds[0]] == 'win'
            && data.results[data.participantIds[1]] == 'lose')
          || (data.results[data.participantIds[0]] == 'lose'
            && data.results[data.participantIds[1]] == 'win')
          || (data.results[data.participantIds[0]] == 'draw'
            && data.results[data.participantIds[1]] == 'draw')
        )
        && data.completedAt is string
        && data.completedAt.size() > 0
        && data.completedAt.size() <= 40
        && data.uploadedBy is string
        && data.uploadedBy == request.auth.uid
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    function isMatchResultUploader() {
      return isSignedIn()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.uploadedBy == request.auth.uid;
    }

    match /presence/{uid} {
      allow read: if isSignedIn()
        && (request.auth.uid == uid || resource.data.isVisible == true);
      allow create, update: if isPresenceOwner(uid)
        && hasValidPresenceFields(request.resource.data)
        && hasValidPresenceValues(request.resource.data);
      allow delete: if isPresenceOwner(uid);
    }

    function hasValidChallengeRequestFields(data) {
      return data.keys().hasAll([
        'challengerId',
        'scannedPlayerId',
        'scannedPlayerName',
        'matchId',
        'status',
        'createdAt',
        'expiresAt'
      ]) && data.keys().hasOnly([
        'challengerId',
        'scannedPlayerId',
        'scannedPlayerName',
        'matchId',
        'status',
        'createdAt',
        'expiresAt'
      ]);
    }

    function hasValidChallengeRequestValues(data) {
      return data.challengerId is string
        && data.challengerId == request.auth.uid
        && data.scannedPlayerId is string
        && data.scannedPlayerId.size() > 0
        && data.challengerId != data.scannedPlayerId
        && data.scannedPlayerName is string
        && data.scannedPlayerName.size() > 0
        && data.matchId is string
        && data.matchId.size() > 0
        && data.status == 'pending'
        && data.createdAt == request.time
        && data.expiresAt is timestamp;
    }

    match /challengeRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && hasValidChallengeRequestFields(request.resource.data)
        && hasValidChallengeRequestValues(request.resource.data);
      // The challenger relays the host's decision received over the duel channel.
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.challengerId
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow create: if isMatchResultUploader()
        && hasValidMatchResultFields(request.resource.data)
        && hasValidMatchResultValues(request.resource.data, matchId);
      allow update, delete: if false;
    }

    // A phone owns its diagnostics; scores remain in the matches collection.
    match /analytics/{analyticsId} {
      // Transactions must also be able to read a document before it exists.
      allow get: if isSignedIn()
        && (resource == null || resource.data.playerId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.playerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll([
          'schemaVersion', 'matchId', 'playerId', 'participantIds', 'platform',
          'completedAt', 'clockOffsetMs', 'calibration', 'thresholds', 'rounds', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'matchId', 'playerId', 'participantIds', 'platform',
          'completedAt', 'clockOffsetMs', 'calibration', 'thresholds', 'rounds', 'createdAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.playerId == request.auth.uid
        && request.resource.data.matchId is string
        && request.resource.data.matchId.size() > 0
        && request.resource.data.matchId.size() <= 128
        && analyticsId == request.resource.data.matchId + '_' + request.auth.uid
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds[0] is string
        && request.resource.data.participantIds[1] is string
        && request.resource.data.participantIds[0].size() > 0
        && request.resource.data.participantIds[1].size() > 0
        && request.resource.data.participantIds[0] != request.resource.data.participantIds[1]
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.platform is string
        && request.resource.data.completedAt is string
        && request.resource.data.completedAt.size() > 0
        && request.resource.data.completedAt.size() <= 40
        && request.resource.data.clockOffsetMs is number
        && request.resource.data.calibration is map
        && request.resource.data.calibration.thetaReady is number
        && request.resource.data.calibration.thetaShoulder is number
        && request.resource.data.thresholds is map
        && request.resource.data.rounds is list
        && request.resource.data.rounds.size() >= 3
        && request.resource.data.rounds.size() <= 4
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Directory of uid -> displayName, used to resolve names on the
    // leaderboard (matches only stores uids).
    match /users/{uid} {
      // A create-only receipt commits atomically with this player's rating.
      match /ratedMatches/{matchId} {
        allow read: if isPresenceOwner(uid);
        allow create: if isPresenceOwner(uid)
          && request.resource.data.keys().hasOnly(['matchId'])
          && request.resource.data.matchId == matchId
          && uid in get(/databases/$(database)/documents/matches/$(matchId)).data.participantIds;
        allow update, delete: if false;
      }
      allow read: if isSignedIn();
      allow create, update: if isPresenceOwner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'eloRating'])
        && (!('displayName' in request.resource.data)
          || (request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0
            && request.resource.data.displayName.size() <= 100))
        && (!('eloRating' in request.resource.data)
          || (request.resource.data.eloRating is int
            && request.resource.data.eloRating >= 0));
      allow delete: if false;
    }
  }
}
