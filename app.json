{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.anonymous.pocketdraw",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.NEARBY_WIFI_DEVICES",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.HIGH_SAMPLING_RATE_SENSORS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "extra": {
      "eas": {
        "projectId": "31082e1b-5705-43e2-b580-01bfc70699ed"
      }
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.anonymous.pocketdraw",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Allow Pocket Draw to connect directly to a nearby opponent for a duel."
      },
      "supportsTablet": true
    },
    "name": "Pocket Draw",
    "orientation": "portrait",
    "owner": "pix-l-crafters",
    "plugins": [
      [
        "react-native-ble-manager",
        {
          "bluetoothAlwaysPermission": "This app requires Bluetooth access.",
          "isBleRequired": true,
          "neverForLocation": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Pocket Draw to use your location while you use the app so you can see yourself on the map."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow Pocket Draw to detect your quick-draw gesture during a duel."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Pocket Draw to use your camera to scan an opponent's challenge QR code."
        }
      ],
      "expo-font",
      "expo-audio",
      "expo-asset",
      "@config-plugins/react-native-webrtc",
      "react-native-wifi-reborn"
    ],
    "slug": "pocket-draw",
    "userInterfaceStyle": "light",
    "version": "0.0.0",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
