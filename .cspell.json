{
  "allowCompoundWords": true,
  "caseSensitive": false,
  "ignorePaths": [
    "**/.git/**",
    "**/.pnpm-lock.json",
    "**/node_modules/**",
    "**/vscode-extension/**",
    ".vscode",
    ".zed",
    "apm.lock.yaml",
    "megalinter",
    "megalinter-reports",
    "package-lock.json",
    "report"
  ],
  "language": "en,en-GB",
  "noConfigSearch": true,
  "useGitignore": true,
  "version": "0.2",
  "words": [
    "artipacked",
    "bunx",
    "cocogitto",
    "devenv",
    "direnv",
    "fcmc",
    "fxqj",
    "GHSA",
    "hbeat",
    "misconfig",
    "MRDGH",
    "nixfmt",
    "nixpkgs",
    "numtide",
    "otbs",
    "pgpr",
    "pipx",
    "pycache",
    "pytest",
    "qvqq",
    "rignore",
    "rqcc",
    "RSSI",
    "rumdl",
    "stefanzweifel",
    "Tera",
    "tombi",
    "topo",
    "treefmt",
    "trivycache",
    "venv",
    "Vulns",
    "yamlfix",
    "zizmor"
  ]
}
