amends "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Builtins.pkl"

local linters = new Mapping<String, Step> {
  ["betterleaks"] = Builtins.betterleaks
  ["gitignore-tidy"] {
    glob = List("**/.*ignore", ".*ignore")
    check = "uvx git+https://github.com/lorenzwalthert/gitignore-tidy {{files}}"
    fix = "uvx git+https://github.com/lorenzwalthert/gitignore-tidy {{files}}"
  }
  ["keep-sorted"] {
    glob = "*"
    check = "keep-sorted --mode lint {{files}}"
    fix = "keep-sorted --mode fix {{files}}"
  }
  ["ls-lint"] {
    check = "ls-lint ."
    batch = false
  }
  ["mise"] = Builtins.mise
  ["pkl-format"] = Builtins.pkl_format
  ["prettier"] = Builtins.prettier
  ["ruff-format"] = Builtins.ruff_format
  ["ruff"] = (Builtins.ruff) {
    depends = List("ruff-format")
  }
  ["rumdl-format"] = Builtins.rumdl_format
  ["rumdl"] = (Builtins.rumdl) {
    depends = List("rumdl-format")
  }
  ["sort-package-json"] = Builtins.sort_package_json
  ["tombi"] = Builtins.tombi
  ["typos"] = Builtins.typos
  ["typstyle"] {
    glob = List("*.typ", "**/*.typ")
    check = "typstyle -c {{files}}"
    fix = "typstyle -i {{files}}"
  }
  ["yamlfix"] {
    types = List("yaml")
    check = "yamlfix --check {{files}}"
    fix = "yamlfix {{files}}"
    depends = List("prettier")
  }
  ["yamllint"] = (Builtins.yamllint) {
    depends = List("yamlfix")
  }
}

hooks {
  ["check"] {
    steps = linters
  }
  ["commit-msg"] {
    steps {
      ["conventional-commit"] = Builtins.cocogitto_commit_msg
      ["typos"] = Builtins.typos
    }
  }
  ["fix"] {
    fix = true
    steps = linters
  }
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
}
