{
  "gitignore": true,
  "ignore": [
    "**/*.svg",
    "**/*cache*/**",
    "**/.git/**",
    "**/.github/**",
    "**/.idea/**",
    "**/.rbenv/**",
    "**/.venv/**",
    "**/node_modules/**",
    "**/package-lock.json",
    "**/report/**",
    "template/**",
    "docs/superpowers/**"
  ],
  "reporters": ["html", "markdown"],
  "threshold": 0
}
